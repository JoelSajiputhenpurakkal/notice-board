# Local SQLite database. Prisma stores this at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Generate a private value with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"

# Optional remote Spring Boot API. Leave empty to use the local Next.js + SQLite API.
NEXT_PUBLIC_API_URL=""
